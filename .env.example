# Copiar a .env.local (desarrollo) o cargar en Vercel (producción).
SITE_URL=https://modaconsteph.com.ar

# Base de datos PostgreSQL (Supabase, Neon…). Sin esto, en desarrollo se usa una base embebida.
DATABASE_URL=

# Secreto para las sesiones del panel (largo y al azar): openssl rand -hex 32
SESSION_SECRET=

# Mercado Pago (cuenta de Steph): Credenciales de producción > Access Token, y clave secreta de Webhooks
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Mails: una de las dos
RESEND_API_KEY=
BREVO_API_KEY=

# Protege la tarea programada de mails (Vercel la manda sola si se define)
CRON_SECRET=

# Seguimiento de compras desde el servidor (ver tracking/LEEME.md). Sin estas claves la reserva funciona igual y el envío se omite.
# Meta: token de la API de Conversiones del Pixel. Analytics: secreto de la API de Measurement Protocol.
META_CAPI_TOKEN=
GA4_API_SECRET=
# Opcional, solo para probar en "Probar eventos" de Meta (sacarla después)
META_TEST_EVENT_CODE=

# Solo desarrollo: 1 = cargar Tag Manager también en local (en producción se carga solo)
MCS_TRACKING=

# Solo desarrollo: 1 = simular el pago de Mercado Pago
MCS_SIMULAR_PAGOS=

# Solo desarrollo: 1 = guardar los mails en .data/mails en vez de enviarlos
MCS_MAILS_A_CARPETA=
