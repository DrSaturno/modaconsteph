# Copiar a .env.local (desarrollo) o cargar en Vercel (producción).
SITE_URL=https://modaconsteph.com.ar

# Base de datos PostgreSQL (Supabase, Neon…). Sin esto, en desarrollo se usa una base embebida.
DATABASE_URL=

# Secreto para las sesiones del panel (largo y al azar): openssl rand -hex 32
SESSION_SECRET=

# Mercado Pago (cuenta de Steph): Credenciales de producción > Access Token, y clave secreta de Webhooks
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Mails: una de las dos
RESEND_API_KEY=
BREVO_API_KEY=

# Protege la tarea programada de mails (Vercel la manda sola si se define)
CRON_SECRET=

# Solo desarrollo: 1 = simular el pago de Mercado Pago
MCS_SIMULAR_PAGOS=

# Solo desarrollo: 1 = guardar los mails en .data/mails en vez de enviarlos
MCS_MAILS_A_CARPETA=
